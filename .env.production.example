# ─── Production environment ───
# Copy to `.env` on the server:  cp .env.production.example .env
# The app validates these at startup and REFUSES TO BOOT on missing/placeholder
# required values (see lib/env.ts). Never commit the filled-in .env.

# ── Database (compose builds DATABASE_URL from these; app talks to the `postgres` service) ──
POSTGRES_USER=zahrat
POSTGRES_PASSWORD=            # REQUIRED — strong password
POSTGRES_DB=zahrat_al_hayat

# DATABASE_URL must match the POSTGRES_* values above (host = the `postgres` service):
DATABASE_URL=postgresql://zahrat:<same password>@postgres:5432/zahrat_al_hayat

# ── Auth (REQUIRED) ──
# min 32 chars: openssl rand -base64 32  (AUTH_SECRET is an accepted alias)
NEXTAUTH_SECRET=            # REQUIRED
NEXTAUTH_URL=https://your-domain.com
# The app sets Auth.js `trustHost: true` in code, so running behind the host
# nginx reverse proxy works without AUTH_TRUST_HOST.

# ── App ──
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Email (optional — enables appointment/notification emails) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com

# ── Stripe (OPTIONAL — booking currently completes via WhatsApp) ──
# Leave blank to run without payments. If set, must be REAL keys (not placeholders).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Database seeding (only used when running `npm run db:seed`) ──
# REQUIRED (min 8 chars each) if you seed in production.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Set to 1 to skip startup env validation (tooling/CI only — never in prod).
# SKIP_ENV_VALIDATION=0
