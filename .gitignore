# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local env
.env
.env.local

# Docker data
postgres_data*
certs/

# Reference design dump (not part of the app)
/sereenity.framer.website

# Test output
/test-results
/playwright-report
.playwright-mcp

# Runtime user uploads (served from public/uploads at runtime)
/public/uploads

# index.html reference
index.html
